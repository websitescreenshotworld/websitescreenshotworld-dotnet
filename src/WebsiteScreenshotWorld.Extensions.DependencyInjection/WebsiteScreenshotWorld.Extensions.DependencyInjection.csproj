<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>WebsiteScreenshotWorld.Extensions.DependencyInjection</PackageId>
    <Version>0.1.0</Version>
    <Description>Registers the Website Screenshot World client with Microsoft.Extensions.DependencyInjection as a typed HttpClient.</Description>
    <RootNamespace>Microsoft.Extensions.DependencyInjection</RootNamespace>
    <PackageTags>$(PackageTags);dependency-injection;httpclientfactory</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../WebsiteScreenshotWorld/WebsiteScreenshotWorld.csproj" />
  </ItemGroup>

</Project>
